          roles:
            - detect
    detect:
      enabled: true
    lpr:
      enabled: true
    face_recognition:
      enabled: true
    review:
      alerts:
        labels:
          - cat
          - dog
          - person
      detections:
        labels:
          - dog
          - cat
          - person
    notifications:
      enabled: true
    motion:
      mask: 0,0,0.353,0,0.353,0.08,0,0.08
  Livingroom:
    enabled: true
    ffmpeg:
      inputs:
        - path: rtsp://omoikane:k4m1z4m4@10.73.19.103/stream1
          roles:
            - detect
    detect:
      enabled: true
    face_recognition:
      enabled: true
    review:
      alerts:
        labels:
          - cat
